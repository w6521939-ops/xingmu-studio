            "sourceItemId": "timeline-1",
            "start": 0,
            "end": 4.5,
            "text": "今晚必须找到答案。"
          },
          {
            "id": "subtitle-2-2",
            "sourceItemId": "timeline-2",
            "start": 4.5,
            "end": 7.7,
            "text": "有人来了。"
          },
          {
            "id": "subtitle-3-3",
            "sourceItemId": "timeline-3",
            "start": 7.7,
            "end": 10.5,
            "text": "果然在这里。"
          },
          {
            "id": "subtitle-4-4",
            "sourceItemId": "timeline-4",
            "start": 10.5,
            "end": 15.6,
            "text": "这次不能错过。"
          },
          {
            "id": "subtitle-5-5",
            "sourceItemId": "timeline-5",
            "start": 15.6,
            "end": 19.2,
            "text": "他也在寻找线索。"
          },
          {
            "id": "subtitle-6-6",
            "sourceItemId": "timeline-6",
            "start": 19.2,
            "end": 23.1,
            "text": "真相就在前方。"
          }
        ],
